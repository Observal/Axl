{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "files": {
    "includes": [
      "**/*.{ts,json}",
      "!**/{dist,node_modules}",
      "!.release",
      "!.reference",
      "!packages/ai/src/catalog.generated.ts",
      "!packages/ai/src/catalog.generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/extensions/mcp/**",
        "packages/sdk/src/mcp.ts",
        "packages/sdk/test/mcp.test.ts",
        "packages/protocol/scripts/generate-conformance.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
