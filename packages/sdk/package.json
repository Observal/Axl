{
  "name": "@axl/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Transport-independent TypeScript client SDK for Axl",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unix": {
      "types": "./dist/unix.d.ts",
      "import": "./dist/unix.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "test": "pnpm --filter @axl/protocol build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axl/protocol": "workspace:*"
  }
}
