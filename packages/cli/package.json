{
  "name": "@axl/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Axl command-line entry point and client selection",
  "license": "Apache-2.0",
  "bin": {
    "axl": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "test": "pnpm build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axl/ai": "workspace:*",
    "@axl/daemon": "workspace:*",
    "@axl/protocol": "workspace:*",
    "@axl/runtime": "workspace:*",
    "@axl/tui": "workspace:*"
  },
  "devDependencies": {
    "@axl/kernel": "workspace:*"
  }
}
