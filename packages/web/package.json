{
  "name": "@axl/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser presentation client for the Axl daemon",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "pnpm --filter @axl/protocol build && pnpm --filter @axl/kernel build && pnpm --filter @axl/daemon build && pnpm --filter @axl/sdk build && node --test test/*.test.ts",
    "test:browser": "AXL_REAL_BROWSER=1 node --test test/real-browser-smoke.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axl/sdk": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axl/cli": "workspace:*",
    "@axl/daemon": "workspace:*",
    "@axl/kernel": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "vite": "8.2.2"
  }
}
