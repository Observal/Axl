{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./dist-types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist-types/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "dist-types", "test"],
  "references": [{ "path": "../sdk/tsconfig.build.json" }]
}
