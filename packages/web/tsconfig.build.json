{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/types/tsconfig.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    { "path": "../protocol/tsconfig.build.json" },
    { "path": "../extensions/api/tsconfig.build.json" },
    { "path": "../sdk/tsconfig.build.json" },
    { "path": "../ui/tsconfig.build.json" }
  ]
}
