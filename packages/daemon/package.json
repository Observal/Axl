{
  "name": "@axl/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative session daemon for Axl",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsc -b tsconfig.build.json --force",
    "test": "pnpm --filter @axl/protocol build && pnpm --filter @axl/kernel build && pnpm --filter @axl/sdk build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axl/kernel": "workspace:*",
    "@axl/protocol": "workspace:*"
  },
  "devDependencies": {
    "@axl/sdk": "workspace:*"
  }
}
