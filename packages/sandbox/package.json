{
  "name": "@axl/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Native sandbox providers for Axl tool execution",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "test": "pnpm --filter @axl/protocol build && pnpm --filter @axl/kernel build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axl/kernel": "workspace:*",
    "@axl/protocol": "workspace:*",
    "@deepseek-ai/node-addon-landlock-run": "0.1.1"
  }
}
