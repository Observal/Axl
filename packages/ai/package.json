{
  "name": "@axl/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provider contract, model metadata, and tool dialects for Axl",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsc -b tsconfig.build.json --force",
    "test": "pnpm --filter @axl/protocol build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "3.972.82",
    "@axl/protocol": "workspace:*",
    "@azure/identity": "4.13.2",
    "@smithy/hash-node": "4.5.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.3",
    "google-auth-library": "11.0.2",
    "undici": "8.10.2"
  }
}
